# Placeholder - no key material is stored in this repository.
#
# The self-signed development RSA private key that used to live here has been
# removed (CWE-798 / hardcoded credential). Private keys must never be
# committed to version control.
#
# To run the app over HTTPS locally, generate a throwaway key/cert pair
# outside of git and point the TLS_KEY_PATH / TLS_CERT_PATH environment
# variables (see server.js) at them, e.g.:
#
#   openssl req -x509 -newkey rsa:4096 -nodes -days 365 \
#       -keyout /tmp/nodegoat/server.key -out /tmp/nodegoat/server.crt
#   export TLS_KEY_PATH=/tmp/nodegoat/server.key
#   export TLS_CERT_PATH=/tmp/nodegoat/server.crt
#
# Files matching artifacts/cert/*.key and *.pem are gitignored so locally
# generated material stays out of commits.
